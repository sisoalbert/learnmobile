# Google AdMob production native App IDs.
# Local, development, and preview builds always ignore these and use Google's test App IDs.
ADMOB_ANDROID_APP_ID=ca-app-pub-394025609xxxxxxxx~xxxxxxxx
ADMOB_IOS_APP_ID=ca-app-pub-394025609xxxxxxxx~xxxxxx

# Google AdMob production ad-unit IDs used by JavaScript ad components.
# Local, development, and preview builds always ignore these and use Google's test ad-unit IDs.
EXPO_PUBLIC_ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-xxxxx/6300978111
EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-xxxxx/1033173712
