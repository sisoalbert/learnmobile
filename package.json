  "scripts": {
    "start": "expo start",
    "start:prod": "NODE_ENV=production expo start --no-dev --clear",
    "build:web": "expo export -p web",
    "dev:web": "expo start --web",
    "deploy": "npm run build:web && wrangler deploy",
    "deploy:web": "npm run build:web && wrangler deploy",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:prod": "NODE_ENV=production expo run:android --variant release --no-build-cache",
    "ios": "expo run:ios",
    "ios:prod": "NODE_ENV=production expo run:ios --configuration Release --no-build-cache",
    "web": "expo start --web",
    "dev": "expo start --web",
    "androidx": "npx expo run:android --device",
    "iosx": "npx expo run:ios --device",
    "iosd": "expo run:ios --device",
    "androidd": "expo run:android --device",
    "bios": "eas build --platform ios",
    "biosl": "eas build --platform ios --local",
    "bandroid": "eas build --platform android",
    "bandroidl": "eas build --platform android --local",
    "clean": "npx expo prebuild --clean",
    "lint": "expo lint",
    "test": "jest --runInBand --no-watchman"
  },
  "jest": {
    "preset": "jest-expo",
    "watchman": false,
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
